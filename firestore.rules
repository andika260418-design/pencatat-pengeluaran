rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/current {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.updatedBy is string
        && request.resource.data.state is map
        && request.resource.data.state.transactions is list
        && request.resource.data.state.categories is list
        && request.resource.data.state.settings is map;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision > resource.data.revision
        && request.resource.data.updatedBy is string
        && request.resource.data.state is map
        && request.resource.data.state.transactions is list
        && request.resource.data.state.categories is list
        && request.resource.data.state.settings is map;
    }
  }
}
